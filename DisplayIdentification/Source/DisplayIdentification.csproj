<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <UseWindowsForms>true</UseWindowsForms>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <ApplicationManifest>Application.manifest</ApplicationManifest>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <!-- Needed for the build to report unnecessary usings (IDE0005). -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <PublishDocumentationFile>false</PublishDocumentationFile>
        <AssemblyName>DisplayIdentification</AssemblyName>
        <RootNamespace>DisplayIdentification</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <!-- Keep the Windows Forms dependency visible in the files that use it. -->
        <Using Remove="System.Drawing" />
        <Using Remove="System.Windows.Forms" />
    </ItemGroup>

</Project>
