<Project DefaultTargets="Build">
  <!--
    Allocator.cpp replaces the global operator new and operator delete, which only works from a
    program's own objects, not from a library's, so Benchmarks.vcxproj and BenchmarksTests.vcxproj
    compile it themselves, as it says.
  -->
  <PropertyGroup>
    <KGamesExclude>Allocator.cpp</KGamesExclude>
  </PropertyGroup>
  <Import Project="..\..\KGames.props" />
  <!-- The libraries, and then the programs whose frames the benchmarks run, by their libraries. -->
  <ItemGroup>
    <ProjectReference Include="..\..\Library\Gltf\Gltf.vcxproj" />
    <ProjectReference Include="..\..\Library\Graphics\Graphics.vcxproj" />
    <ProjectReference Include="..\..\Library\Json\Json.vcxproj" />
    <ProjectReference Include="..\..\Library\Math\Math.vcxproj" />
    <ProjectReference Include="..\..\Library\PolygonMesh\PolygonMesh.vcxproj" />
    <ProjectReference Include="..\..\Library\PresentTiming\PresentTiming.vcxproj" />
    <ProjectReference Include="..\..\Library\SimplePaint\SimplePaint.vcxproj" />
    <ProjectReference Include="..\..\Library\UserInterface\UserInterface.vcxproj" />
    <ProjectReference Include="..\GameInputDemo\GameInputDemoLibrary.vcxproj" />
    <ProjectReference Include="..\MeshModeler\MeshModelerLibrary.vcxproj" />
    <ProjectReference Include="..\MinimalSceneTest\MinimalSceneTestLibrary.vcxproj" />
    <ProjectReference Include="..\SimplePaintDemo\SimplePaintDemoLibrary.vcxproj" />
    <ProjectReference Include="..\SpinningCarTest\SpinningCarTestLibrary.vcxproj" />
    <ProjectReference Include="..\UiShowcase\UiShowcaseLibrary.vcxproj" />
    <ProjectReference Include="..\Veehiicuul\VeehiicuulLibrary.vcxproj" />
  </ItemGroup>
  <Import Project="..\..\KGames.targets" />
</Project>
