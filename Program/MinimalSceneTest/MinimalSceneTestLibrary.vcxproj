<Project DefaultTargets="Build">
  <Import Project="..\..\KGames.props" />
  <ItemGroup>
    <ProjectReference Include="..\..\Library\Graphics\Graphics.vcxproj" />
    <ProjectReference Include="..\..\Library\Json\Json.vcxproj" />
    <ProjectReference Include="..\..\Library\Math\Math.vcxproj" />
    <ProjectReference Include="..\..\Library\Meshes\Meshes.vcxproj" />
    <ProjectReference Include="..\..\Library\PaintSettings\PaintSettings.vcxproj" />
    <ProjectReference Include="..\..\Library\SimplePaint\SimplePaint.vcxproj" />
    <ProjectReference Include="..\..\Library\UserInterface\UserInterface.vcxproj" />
  </ItemGroup>
  <!--
    SimplePaint's shaders, for the scene's three materials, compiled to DXIL as the library builds,
    from where Library\SimplePaint has them.
  -->
  <ItemGroup>
    <Shader Include="$(KGamesRoot)Library\SimplePaint\Shaders\SimplePaint.hlsl" Name="SimplePaint" Arguments="-O3 -Ges -WX -D SIMPLE_PAINT_MATERIAL_COUNT=3" />
  </ItemGroup>
  <Import Project="..\..\KGames.targets" />
</Project>
