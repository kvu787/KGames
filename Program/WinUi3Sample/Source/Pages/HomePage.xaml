<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinUi3Sample.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinUi3Sample">

    <Page.Resources>
        <!-- A quick action: a button that looks like a card, with an icon, a title and a description. -->
        <Style x:Key="ActionCardButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Padding="36,24,36,36" Spacing="24">
            <!-- The banner, in the accent color, with the dark theme's text and buttons over it. -->
            <Grid
                Height="232"
                Padding="40,32"
                Background="{ThemeResource HeroBackgroundBrush}"
                CornerRadius="{StaticResource OverlayCornerRadius}"
                RequestedTheme="Dark">
                <StackPanel VerticalAlignment="Center" Spacing="8">
                    <TextBlock
                        x:Name="Greeting"
                        Style="{StaticResource TitleLargeTextBlockStyle}"
                        Text="Good morning" />
                    <TextBlock
                        MaxWidth="720"
                        HorizontalAlignment="Left"
                        FontSize="18"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="This is a sample of a WinUI 3 app: a small notes app, with Mica, its own title bar, a menu bar, a navigation pane, and WinUI 3's controls in their Fluent styles."
                        TextWrapping="Wrap" />
                    <StackPanel Margin="0,12,0,0" Orientation="Horizontal" Spacing="8">
                        <Button Click="OnNewNote" Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="16" Glyph="&#xE710;" />
                                <TextBlock Text="New note" />
                            </StackPanel>
                        </Button>
                        <Button Click="OnShowControls" Content="See the controls" />
                    </StackPanel>
                </StackPanel>
                <FontIcon
                    Margin="0,0,24,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    FontSize="160"
                    Glyph="&#xE70B;"
                    Opacity="0.25" />
            </Grid>

            <!-- Quick actions. -->
            <StackPanel Spacing="12">
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Get started" />
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Click="OnNewNote" Style="{StaticResource ActionCardButtonStyle}">
                        <StackPanel Spacing="8">
                            <FontIcon HorizontalAlignment="Left" FontSize="28" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Glyph="&#xE70B;" />
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Write a note" />
                            <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" Text="Start a blank note, or one from a template in the File menu." TextWrapping="Wrap" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="1" Click="OnOpen" Style="{StaticResource ActionCardButtonStyle}">
                        <StackPanel Spacing="8">
                            <FontIcon HorizontalAlignment="Left" FontSize="28" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Glyph="&#xE8E5;" />
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Open a text file" />
                            <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" Text="Pick a .txt or .md file with the Windows App SDK's file picker." TextWrapping="Wrap" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" Click="OnShowControls" Style="{StaticResource ActionCardButtonStyle}">
                        <StackPanel Spacing="8">
                            <FontIcon HorizontalAlignment="Left" FontSize="28" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Glyph="&#xE8A9;" />
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Browse the controls" />
                            <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" Text="Buttons, text boxes, pickers, progress, info bars, dialogs and more." TextWrapping="Wrap" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="3" Click="OnShowSettings" Style="{StaticResource ActionCardButtonStyle}">
                        <StackPanel Spacing="8">
                            <FontIcon HorizontalAlignment="Left" FontSize="28" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Glyph="&#xE790;" />
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Make it yours" />
                            <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" Text="Switch the theme with F9, and the backdrop and navigation in Settings." TextWrapping="Wrap" />
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>

            <InfoBar
                IsClosable="True"
                IsOpen="True"
                Message="The menu bar's accelerators, like Ctrl+N and Ctrl+S, work from anywhere in the window. Press Alt to see its access keys."
                Severity="Informational"
                Title="Tip" />

            <Grid ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Pinned notes, as cards. -->
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Pinned" />
                    <GridView
                        x:Name="PinnedNotes"
                        IsItemClickEnabled="True"
                        ItemClick="OnNoteClick"
                        SelectionMode="None">
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="local:Note">
                                <Grid
                                    Width="300"
                                    Height="168"
                                    Padding="16"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource OverlayCornerRadius}"
                                    RowSpacing="6">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind DisplayTitle}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Grid.Row="1"
                                        Style="{StaticResource SecondaryCaptionTextStyle}"
                                        Text="{x:Bind Preview}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="Wrap" />
                                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Glyph="&#xE718;" />
                                        <TextBlock Foreground="{ThemeResource TextFillColorTertiaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind ModifiedText}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                    <TextBlock
                        x:Name="NoPinnedNotes"
                        Style="{StaticResource SecondaryTextStyle}"
                        Text="No notes are pinned. Pin one with Ctrl+D or the Edit menu."
                        Visibility="Collapsed" />
                </StackPanel>

                <!-- Recently edited notes, as a list. -->
                <StackPanel Grid.Column="1" Spacing="12">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Recently edited" />
                    <Border Padding="0,4" Style="{StaticResource CardStyle}">
                        <ListView
                            x:Name="RecentNotes"
                            IsItemClickEnabled="True"
                            ItemClick="OnNoteClick"
                            SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:Note">
                                    <Grid Padding="0,10" ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon VerticalAlignment="Center" FontSize="20" Glyph="&#xE8A5;" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="{x:Bind DisplayTitle}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" Text="{x:Bind ModifiedText}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
