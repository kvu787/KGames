<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinUi3Sample.ControlsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinUi3Sample">

    <ScrollViewer>
        <StackPanel Padding="36,24,36,36" Spacing="16">
            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Controls" />
                <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="WinUI 3's common controls, in their default Fluent styles. Each works, and none has a style of this app's own." />
            </StackPanel>

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Column 1 -->
                <StackPanel Spacing="16">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Style="{StaticResource CardHeaderTextStyle}" Text="Buttons" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Click="OnCountedClick" Content="Standard" />
                                <Button Click="OnCountedClick" Content="Accent" Style="{StaticResource AccentButtonStyle}" />
                                <Button Content="Disabled" IsEnabled="False" />
                            </StackPanel>
                            <TextBlock x:Name="ClickCount" Style="{StaticResource SecondaryCaptionTextStyle}" Text="Press a button" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ToggleButton Content="Toggle button" />
                                <DropDownButton Content="Drop-down">
                                    <DropDownButton.Flyout>
                                        <MenuFlyout Placement="Bottom">
                                            <MenuFlyoutItem Text="Send">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE724;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Reply">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE8CA;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Reply all">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE8C2;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </DropDownButton.Flyout>
                                </DropDownButton>
                                <SplitButton Click="OnSplitClick" Content="Split button">
                                    <SplitButton.Flyout>
                                        <MenuFlyout Placement="Bottom">
                                            <MenuFlyoutItem Text="Option one" />
                                            <MenuFlyoutItem Text="Option two" />
                                        </MenuFlyout>
                                    </SplitButton.Flyout>
                                </SplitButton>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button AutomationProperties.Name="Like" ToolTipService.ToolTip="Like">
                                    <FontIcon FontSize="16" Glyph="&#xE8E1;" />
                                </Button>
                                <Button>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="16" Glyph="&#xE72D;" />
                                        <TextBlock Text="Share" />
                                    </StackPanel>
                                </Button>
                                <RepeatButton Click="OnRepeat" Content="Hold to repeat" />
                            </StackPanel>
                            <HyperlinkButton Padding="0" Content="A hyperlink button" NavigateUri="https://learn.microsoft.com/windows/apps/design/controls/" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Style="{StaticResource CardHeaderTextStyle}" Text="Checkboxes, radio buttons and switches" />
                            <CheckBox Content="Checked" IsChecked="True" />
                            <CheckBox Content="Three-state, now indeterminate" IsChecked="{x:Null}" IsThreeState="True" />
                            <CheckBox Content="Disabled" IsEnabled="False" />
                            <RadioButtons Header="Radio buttons" MaxColumns="3" SelectedIndex="1">
                                <x:String>Small</x:String>
                                <x:String>Medium</x:String>
                                <x:String>Large</x:String>
                            </RadioButtons>
                            <ToggleSwitch Header="Toggle switch" IsOn="True" />
                            <ToggleSwitch Header="With its own words" OffContent="Do not disturb is off" OnContent="Do not disturb is on" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Style="{StaticResource CardHeaderTextStyle}" Text="Rating" />
                            <RatingControl HorizontalAlignment="Left" Caption="(128 ratings)" IsClearEnabled="True" Value="3.5" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Column 2 -->
                <StackPanel Grid.Column="1" Spacing="16">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Style="{StaticResource CardHeaderTextStyle}" Text="Text input" />
                            <TextBox Header="Text box" PlaceholderText="Type your name" />
                            <PasswordBox Header="Password box" PlaceholderText="Enter a password" />
                            <NumberBox
                                Header="Number box"
                                LargeChange="10"
                                SmallChange="1"
                                SpinButtonPlacementMode="Inline"
                                Value="42" />
                            <AutoSuggestBox
                                Header="Auto-suggest box"
                                PlaceholderText="Search fruits"
                                QueryIcon="Find"
                                TextChanged="OnFruitTextChanged" />
                            <TextBox
                                Height="96"
                                AcceptsReturn="True"
                                Header="Multi-line text box"
                                PlaceholderText="Write a few lines"
                                TextWrapping="Wrap" />
                            <TextBox Header="Disabled" IsEnabled="False" Text="Can't change this" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Style="{StaticResource CardHeaderTextStyle}" Text="Combo boxes" />
                            <ComboBox Width="240" Header="Combo box" SelectedIndex="0">
                                <x:String>Blue</x:String>
                                <x:String>Green</x:String>
                                <x:String>Orange</x:String>
                                <x:String>Purple</x:String>
                            </ComboBox>
                            <ComboBox
                                Width="240"
                                Header="Editable combo box"
                                IsEditable="True"
                                SelectedIndex="2">
                                <x:String>8</x:String>
                                <x:String>10</x:String>
                                <x:String>12</x:String>
                                <x:String>14</x:String>
                                <x:String>18</x:String>
                                <x:String>24</x:String>
                            </ComboBox>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Column 3 -->
                <StackPanel Grid.Column="2" Spacing="16">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Style="{StaticResource CardHeaderTextStyle}" Text="Sliders and progress" />
                            <Slider
                                x:Name="VolumeSlider"
                                Header="Volume"
                                Maximum="100"
                                Value="60" />
                            <Slider
                                Header="With ticks, snapping to them"
                                Maximum="10"
                                SnapsTo="Ticks"
                                TickFrequency="1"
                                TickPlacement="Outside"
                                Value="4" />
                            <Slider Header="Disabled" IsEnabled="False" Value="30" />
                            <TextBlock Style="{StaticResource SecondaryCaptionTextStyle}" Text="A progress bar at the volume, and one of unknown length" />
                            <ProgressBar Maximum="100" Value="{x:Bind VolumeSlider.Value, Mode=OneWay}" />
                            <ProgressBar IsIndeterminate="True" />
                            <StackPanel Orientation="Horizontal" Spacing="24">
                                <ProgressRing IsActive="True" />
                                <ProgressRing IsIndeterminate="False" Maximum="100" Value="{x:Bind VolumeSlider.Value, Mode=OneWay}" />
                                <Grid>
                                    <Button Content="Inbox" />
                                    <InfoBadge
                                        Margin="0,-6,-6,0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Value="5" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Style="{StaticResource CardHeaderTextStyle}" Text="Info bars" />
                            <InfoBar
                                IsClosable="False"
                                IsOpen="True"
                                Message="Something worth knowing."
                                Severity="Informational"
                                Title="Informational" />
                            <InfoBar
                                IsClosable="False"
                                IsOpen="True"
                                Message="The note was saved."
                                Severity="Success"
                                Title="Success" />
                            <InfoBar
                                IsOpen="True"
                                Message="This one closes. Close it."
                                Severity="Warning"
                                Title="Warning" />
                            <InfoBar
                                IsClosable="False"
                                IsOpen="True"
                                Message="The file couldn't be opened."
                                Severity="Error"
                                Title="Error">
                                <InfoBar.ActionButton>
                                    <Button Content="Try again" />
                                </InfoBar.ActionButton>
                            </InfoBar>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Style="{StaticResource CardHeaderTextStyle}" Text="Dates and times" />
                            <CalendarDatePicker Header="Calendar date picker" PlaceholderText="Pick a date" />
                            <DatePicker Header="Date picker" />
                            <TimePicker Header="Time picker" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Column 4 -->
                <StackPanel Grid.Column="3" Spacing="16">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Style="{StaticResource CardHeaderTextStyle}" Text="Dialogs and flyouts" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Click="OnShowDialog" Content="Content dialog" />
                                <Button Content="Flyout">
                                    <Button.Flyout>
                                        <Flyout>
                                            <StackPanel Width="240" Spacing="12">
                                                <TextBlock Text="A flyout holds anything, like this text and a button." TextWrapping="Wrap" />
                                                <Button Content="Got it" Style="{StaticResource AccentButtonStyle}" />
                                            </StackPanel>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                                <Button x:Name="TipButton" Click="OnShowTip" Content="Teaching tip" />
                            </StackPanel>
                            <Border
                                Height="72"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource ControlCornerRadius}">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource SecondaryTextStyle}"
                                    Text="Right-click here for a context menu" />
                                <Border.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="Cut">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE8C6;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Copy">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE8C8;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Paste">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE77F;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutSubItem Text="Sort by">
                                            <RadioMenuFlyoutItem GroupName="Sort" IsChecked="True" Text="Name" />
                                            <RadioMenuFlyoutItem GroupName="Sort" Text="Date" />
                                            <RadioMenuFlyoutItem GroupName="Sort" Text="Size" />
                                        </MenuFlyoutSubItem>
                                    </MenuFlyout>
                                </Border.ContextFlyout>
                            </Border>
                            <Expander
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Content="An expander shows more when it's opened, like this."
                                Header="Expander" />
                            <TeachingTip
                                x:Name="Tip"
                                Title="A teaching tip"
                                Subtitle="It points at what it's about, and closes with its button."
                                Target="{x:Bind TipButton}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Style="{StaticResource CardHeaderTextStyle}" Text="Navigation and collections" />
                            <SelectorBar>
                                <SelectorBarItem IsSelected="True" Text="Recent" />
                                <SelectorBarItem Text="Shared" />
                                <SelectorBarItem Text="Favorites" />
                            </SelectorBar>
                            <BreadcrumbBar x:Name="Breadcrumbs" />
                            <TreeView Height="200" SelectionMode="Single">
                                <TreeView.RootNodes>
                                    <TreeViewNode Content="Documents" IsExpanded="True">
                                        <TreeViewNode.Children>
                                            <TreeViewNode Content="Notes" IsExpanded="True">
                                                <TreeViewNode.Children>
                                                    <TreeViewNode Content="Groceries.txt" />
                                                    <TreeViewNode Content="Trip to Kyoto.txt" />
                                                </TreeViewNode.Children>
                                            </TreeViewNode>
                                            <TreeViewNode Content="Budget.xlsx" />
                                        </TreeViewNode.Children>
                                    </TreeViewNode>
                                    <TreeViewNode Content="Pictures" />
                                    <TreeViewNode Content="Music" />
                                </TreeView.RootNodes>
                            </TreeView>
                            <TabView Height="160" AddTabButtonClick="OnAddTab" TabCloseRequested="OnCloseTab">
                                <TabViewItem Header="First tab">
                                    <TabViewItem.IconSource>
                                        <FontIconSource Glyph="&#xE8A5;" />
                                    </TabViewItem.IconSource>
                                    <TextBlock Margin="16" Text="A tab view, like a browser's. Add tabs with its + button." TextWrapping="Wrap" />
                                </TabViewItem>
                                <TabViewItem Header="Second tab">
                                    <TabViewItem.IconSource>
                                        <FontIconSource Glyph="&#xE8A5;" />
                                    </TabViewItem.IconSource>
                                    <TextBlock Margin="16" Text="The second tab." />
                                </TabViewItem>
                            </TabView>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Style="{StaticResource CardHeaderTextStyle}" Text="Color" />
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Rectangle
                                    x:Name="ColorSwatch"
                                    Width="32"
                                    Height="32"
                                    Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                    RadiusX="4"
                                    RadiusY="4"
                                    Stroke="{ThemeResource ControlStrokeColorDefaultBrush}" />
                                <DropDownButton Content="Pick a color">
                                    <DropDownButton.Flyout>
                                        <Flyout Placement="Bottom">
                                            <ColorPicker
                                                ColorChanged="OnColorChanged"
                                                IsAlphaEnabled="False"
                                                IsColorChannelTextInputVisible="False"
                                                IsHexInputVisible="True"
                                                IsMoreButtonVisible="False" />
                                        </Flyout>
                                    </DropDownButton.Flyout>
                                </DropDownButton>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
