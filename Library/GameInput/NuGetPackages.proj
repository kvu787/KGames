<!--
  The NuGet packages that Library/GameInput needs, declared the way a .NET project declares its own.
  Build.rs restores them with dotnet, in locked mode, into NuGet's global packages folder, and
  packages.lock.json pins each one's content by its hash, as Cargo.lock does for crates. Nothing
  builds this project: it only lists packages.
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- A restore needs a target framework, though nothing here is .NET. -->
    <TargetFramework>net10.0</TargetFramework>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <!--
      Exactly the version of the runtime that the user installs (see Source/Installation.rs).
      ExcludeAssets keeps its build files out of this project, and GeneratePathProperty gives its
      folder as PkgMicrosoft_GameInput, which Build.rs reads.
    -->
    <PackageReference Include="Microsoft.GameInput" Version="[4.0.306]" ExcludeAssets="all" GeneratePathProperty="true" />
  </ItemGroup>
</Project>
