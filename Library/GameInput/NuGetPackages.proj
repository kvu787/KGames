<!--
  The NuGet packages that Library/GameInput needs, declared the way a .NET project declares its own.
  Program\Build\Build.ps1 restores them with dotnet, in locked mode, into NuGet's global packages
  folder, and packages.lock.json pins each one's content by its hash. Nothing builds this project:
  it only lists packages.
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- A restore needs a target framework, though nothing here is .NET. -->
    <TargetFramework>net10.0</TargetFramework>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <!--
      Exactly the version of the runtime that the user installs (see Installation.h).
      ExcludeAssets keeps its build files out of this project, and GeneratePathProperty gives its
      folder as PkgMicrosoft_GameInput, which GameInput.props reads.
    -->
    <PackageReference Include="Microsoft.GameInput" Version="[4.0.306]" ExcludeAssets="all" GeneratePathProperty="true" />
  </ItemGroup>
</Project>
