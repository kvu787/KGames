{
  // Zed's rust-analyzer builds what its analysis needs, build scripts, proc macros and cargo
  // check, in target/Zed, a folder of its own, as VS Code and RustRover do in theirs (see
  // README.md's Editors), so that it never waits on another's build, nor rebuilds over it.
  "lsp": {
    "rust-analyzer": {
      "initialization_options": {
        "cargo": {
          "targetDir": "target/Zed"
        }
      }
    }
  }
}
