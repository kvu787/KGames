{
  // rust-analyzer builds what its analysis needs, build scripts, proc macros and cargo check, in
  // target/VsCode, a folder of its own, as Zed and RustRover do in theirs (see README.md's
  // Editors), so that it never waits on another's build, nor rebuilds over it.
  "rust-analyzer.cargo.targetDir": "target/VsCode",

  // Builds churn through target, and the agents' worktrees, which hold builds of their own, and
  // neither is this checkout's source.
  "files.watcherExclude": {
    "target": true,
    ".claude/worktrees": true
  }
}
