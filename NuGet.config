<?xml version="1.0" encoding="utf-8"?>
<!--
  Where every dotnet restore in the repository gets NuGet packages from: nuget.org alone, whatever
  package sources the machine has, so that a restore gets the same packages on every machine.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
